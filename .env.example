# Settings for docker compose. Copy to .env: cp .env.example .env
# .env holds passwords: it is not in Git; on a server run chmod 600 .env.
# Lines starting with "#" are optional, the value shown is the default. Details: docs/DEPLOY.md.

# --- Required -------------------------------------------------------------

# Database password (letters and digits only). Server: openssl rand -hex 24
# It is applied on the FIRST start only; to change it later see docs/DEPLOY.md, section 10.5.
POSTGRES_PASSWORD=expenses

# pgAdmin login (read on the first pgAdmin start, see section 10.5a)
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=admin

# --- First users ----------------------------------------------------------
# Everything else (people, cards, categories) is managed in the app, on the "Группа" page.
# The variables below only prepare the first group on the first start.

# Passwords, at least 8 characters (openssl rand -base64 18); stored hashed. Needed on a server.
AUTH_PASSWORD_MISHA=
AUTH_PASSWORD_NASTYA=

# Login:default card
# AUTH_USERS=misha:Миша,nastya:Настя
# Application administrators (they create groups)
# ADMIN_USERS=misha
# Owners of the first group
# EDITOR_USERS=misha
# DEFAULT_GROUP_NAME=Семья
# CARDS=Миша,Настя
# CATEGORIES=кафе,одежда,продукты,жилье,маркетплейс,другое

# --- Application ----------------------------------------------------------

# APP_TIMEZONE=Asia/Yerevan
# DEFAULT_CURRENCY=AMD
# CURRENCIES=AMD,RUB,USD,EUR
# Central Bank of Armenia rates
# EXCHANGE_RATES_URL=https://cb.am/latest.json.php
# EXCHANGE_RATES_REFRESH_HOURS=6
# ACCESS_TOKEN_TTL_HOURS=24
# REFRESH_TOKEN_TTL_DAYS=7
# SESSION_MAX_DAYS=30
# AUTH_MIN_PASSWORD_LENGTH=8
# Extra site addresses, usually not needed
# ALLOWED_ORIGINS=
# BACKUP_RETENTION_DAYS=30
# AI receipt parsing (v4): the key is entered by the administrator in the app; SECRETS_KEY (32+ random characters)
# encrypts it in the database. GEMINI_* are fallbacks and defaults.
# SECRETS_KEY=
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.8-flash
# AI_DAILY_LIMIT=30
# Folder of the database backups (scripts/backup-db.sh): the app shows their state to the administrator
# DB_BACKUP_DIR=/home/user/backups
# Warn after this many hours without a good backup
# DB_BACKUP_MAX_AGE_HOURS=26

# --- Excel sync (DEPRECATED, off by default) ------------------------------
# Leave ONEDRIVE_FILE_PATH empty to keep expenses in the database only.
ONEDRIVE_FILE_PATH=Документы/Расходы-dev.xlsx
# Remote name in secrets/rclone.conf
# ONEDRIVE_REMOTE=onedrive
# EXCEL_SHEET_NAME=Лист1
# EXCEL_TABLE_NAME=Операции
# SYNC_INTERVAL_MINUTES=5
# SYNC_RETRY_SECONDS=60
# SYNC_INLINE_WAIT_SECONDS=15
# SYNC_MAX_DELETE_PERCENT=25

# --- Ports (all on 127.0.0.1) ---------------------------------------------

# HTTP_PORT=8080
# HTTPS_PORT=8443
# PGADMIN_PORT=5051
# POSTGRES_PORT=5433
# 0.0.0.0 only together with the public mode below
# WEB_BIND=127.0.0.1

# --- Public access over HTTPS (server only, docs/DEPLOY.md, section 8) ----

# Keeps public mode on a plain `docker compose up`
# COMPOSE_FILE=docker-compose.yml:docker-compose.public.yml
# SITE_ADDRESS=expenses.example.com
# PGADMIN_ADDRESS=pgadmin.example.com
# PGADMIN_BASIC_AUTH_USER=admin
# Hash: docker run --rm -it expenses-tracker-web caddy hash-password (keep the single quotes)
# PGADMIN_BASIC_AUTH_HASH='$2a$14$...'

# Web Push (v5): notifications on the lock screen of phones and computers. All three VAPID values make it work; empty: off.
# Make the pair once: `cd backend && npm run push:keys`, then never change it (a new pair disconnects every device).
# VAPID_SUBJECT is `mailto:you@example.com` or the site address. PUSH_ALLOWED_HOSTS (comma separated) adds hosts allowed as
# push endpoints besides the known services of Apple, Google, Mozilla and Microsoft; normally leave it empty.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=
# PUSH_ALLOWED_HOSTS=
