# Настройки docker compose. Скопируйте в .env:  cp .env.example .env
# (Для запуска backend на Mac через ./scripts/start-all.sh остаётся пароль по умолчанию.)

# Пароль PostgreSQL. На сервере замените на случайный: openssl rand -hex 24
# Только буквы и цифры: пароль подставляется в DATABASE_URL.
POSTGRES_PASSWORD=expenses

# Путь к Excel в OneDrive (обязательно). Для проб используйте тестовый файл.
ONEDRIVE_FILE_PATH=Документы/Расходы-dev.xlsx
# ONEDRIVE_REMOTE=onedrive

# pgAdmin (веб-интерфейс к базе): http://127.0.0.1:5051
# Замените пароль, если компьютер используется не только вами.
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=admin
# PGADMIN_PORT=5051

# Порт PostgreSQL на localhost (для запуска backend вне Docker)
# POSTGRES_PORT=5433

# Веб-интерфейс: http://127.0.0.1:8080
# HTTP_PORT=8080
# HTTPS_PORT=8443
# Адрес для доступа с других устройств (0.0.0.0) только после появления авторизации!
# WEB_BIND=127.0.0.1
# Домен включает автоматический HTTPS через Caddy, например expenses.example.com
# SITE_ADDRESS=:80

# Необязательные настройки (значения по умолчанию)
# APP_TIMEZONE=Asia/Yerevan
# DEFAULT_CURRENCY=AMD
# CARDS=Миша,Настя
# CATEGORIES=кафе,одежда,продукты,жилье,маркетплейс,другое
# BACKUP_RETENTION_DAYS=30
# SYNC_INTERVAL_MINUTES=5
# SYNC_RETRY_SECONDS=60

# --- Публичный доступ (docker-compose.public.yml): HTTPS + вход по паролю ---
# SITE_ADDRESS=85-209-51-95.nip.io        # IP вашего сервера с дефисами + .nip.io, либо свой домен
# Адрес pgAdmin: отдельное имя того же сервера (для nip.io — pgadmin. перед адресом сайта)
# PGADMIN_ADDRESS=pgadmin.85-209-51-95.nip.io
# BASIC_AUTH_USER=misha
# Хеш пароля: docker run --rm caddy:2-alpine caddy hash-password --plaintext 'ваш-длинный-пароль'
# Значение ОБЯЗАТЕЛЬНО в одинарных кавычках (в хеше есть символы $):
# BASIC_AUTH_HASH='$2a$14$...'
