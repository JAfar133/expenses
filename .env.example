# Настройки docker compose. Скопируйте в .env:   cp .env.example .env
# Файл .env не попадает в Git (в нём пароли). Права на сервере: chmod 600 .env
#
# Для запуска на Mac через ./scripts/start-all.sh достаточно значений по умолчанию.
# Строки с «#» в начале необязательны: значение в них равно тому, что используется по умолчанию.

# ============================================================================
# 1. ОСНОВНОЕ (пароли базы и pgAdmin обязательны; пароли входа обязательны только на сервере; Excel необязателен)
# ============================================================================

# Пароль PostgreSQL. На сервере замените на случайный: openssl rand -hex 24
# Только буквы и цифры: пароль подставляется в адрес подключения DATABASE_URL.
# ВАЖНО: пароль записывается в базу при ПЕРВОМ запуске. Если поменять его в .env позже, база
# останется со старым паролем, и backend перестанет подключаться.
# Правильный порядок смены: docs/DEPLOY.md, раздел 10.5.
POSTGRES_PASSWORD=expenses

# Вход в pgAdmin (веб-интерфейс к базе). Пароль замените на свой.
# Так же, как и пароль базы, читается только при первом запуске pgAdmin (раздел 10.5a в docs/DEPLOY.md).
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=admin

# Пароли для входа в приложение, не короче 8 символов. Сгенерировать: openssl rand -base64 18
# На сервере (docker-compose.public.yml) обязательны; при запуске только базы для разработки не нужны.
# Логин: misha и nastya (список пользователей и их карт по умолчанию: AUTH_USERS ниже).
# Backend при каждом запуске хеширует эти пароли (scrypt) и сохраняет только хеш. Чтобы сменить пароль,
# измените значение здесь и перезапустите backend (docker compose up -d): все входы этого пользователя завершатся.
# Значение в .env это открытый текст: держите файл с правами 600 и не публикуйте его.
AUTH_PASSWORD_MISHA=
AUTH_PASSWORD_NASTYA=

# Путь к Excel-файлу в OneDrive. НЕОБЯЗАТЕЛЬНО: если переменная пуста или не задана, работа с Excel отключена,
# расходы хранятся только в базе (значок синхронизации в интерфейсе не показывается).
# Если задана, а файла нет или OneDrive недоступен, приложение не падает: расходы сохраняются в базе
# и ждут в очереди, пока файл не станет доступен.
# Сначала используйте тестовый файл, а на рабочий переходите после проверки (docs/DEPLOY.md, раздел 10.6).
ONEDRIVE_FILE_PATH=Документы/Расходы-dev.xlsx
# Имя remote в конфигурации rclone (secrets/rclone.conf)
# ONEDRIVE_REMOTE=onedrive

# ============================================================================
# 2. EXCEL
# ============================================================================

# Лист и структурированная таблица, в которые записываются расходы
# EXCEL_SHEET_NAME=Лист1
# EXCEL_TABLE_NAME=Операции

# ============================================================================
# 3. ПРИЛОЖЕНИЕ
# ============================================================================

# Пользователи приложения: логин:карта по умолчанию, через запятую. Логин: латинские строчные буквы, цифры, _.
# Карта выбирается в форме расхода по умолчанию для этого пользователя. Для нового пользователя добавьте
# его пароль переменной AUTH_PASSWORD_<ЛОГИН> (и строку в docker-compose.yml). Пользователи, убранные из списка, отключаются.
# AUTH_USERS=misha:Миша,nastya:Настя
# Кто может править и удалять записи на вкладке «Операции» (логины через запятую); остальные пользователи только смотрят.
# Правка и удаление сразу переносятся в Excel: строка заменяется или убирается (если файл занят, изменение ждёт в очереди).
# EDITOR_USERS=misha
# Как долго пользователь остаётся в системе без повторного ввода пароля:
# access-токен (кука входа) живёт 24 часа, затем обновляется по refresh-токену (7 дней, продлевается при использовании),
# но не дольше SESSION_MAX_DAYS с момента ввода пароля.
# ACCESS_TOKEN_TTL_HOURS=24
# REFRESH_TOKEN_TTL_DAYS=7
# SESSION_MAX_DAYS=30
# Минимальная длина пароля входа (не меньше 8)
# AUTH_MIN_PASSWORD_LENGTH=8
# Дополнительные адреса сайта, с которых разрешены запросы (обычно не нужно: проверяется адрес самого сайта)
# ALLOWED_ORIGINS=

# APP_TIMEZONE=Asia/Yerevan
# Базовая валюта: в ней ведётся учёт и Excel. Остальные валюты из CURRENCIES пересчитываются в неё по курсу
# DEFAULT_CURRENCY=AMD
# Валюты, в которых можно вводить расходы (список через запятую; для каждой нужен курс в источнике)
# CURRENCIES=AMD,RUB,USD,EUR
# Источник курсов: официальные курсы ЦБ Армении (драммы за единицу валюты). Курс берётся раз в несколько часов
# и сохраняется в базе; если источник недоступен, используется последний известный курс, а курс можно ввести вручную
# EXCHANGE_RATES_URL=https://cb.am/latest.json.php
# EXCHANGE_RATES_REFRESH_HOURS=6
# Списки через запятую. К категориям добавляются значения из базы (в том числе из Excel).
# CARDS=Миша,Настя
# CATEGORIES=кафе,одежда,продукты,жилье,маркетплейс,другое
# Сколько дней хранить резервные копии Excel и ключи защиты от дублей
# BACKUP_RETENTION_DAYS=30

# ============================================================================
# 4. СИНХРОНИЗАЦИЯ С EXCEL
# ============================================================================

# Как часто сверять Excel и базу
# SYNC_INTERVAL_MINUTES=5
# Пока записи не удаётся дописать в Excel (файл открыт), пробовать чаще
# SYNC_RETRY_SECONDS=60
# Сколько секунд ждать записи в Excel перед ответом на создание расхода (дольше: расход остаётся в очереди)
# SYNC_INLINE_WAIT_SECONDS=15
# Защита от массовой потери: какую долю записей можно пометить удалёнными за один цикл
# (если пропало больше, например при подмене Excel пустым файлом, удаление не применяется)
# SYNC_MAX_DELETE_PERCENT=25

# ============================================================================
# 5. ПОРТЫ (все слушают только 127.0.0.1)
# ============================================================================

# Веб-интерфейс: http://127.0.0.1:8080
# HTTP_PORT=8080
# HTTPS_PORT=8443
# pgAdmin: http://127.0.0.1:5051
# PGADMIN_PORT=5051
# PostgreSQL на localhost (для запуска backend вне Docker). Не 5432, чтобы не мешать другим базам.
# POSTGRES_PORT=5433
# Адрес, на котором слушает web. 0.0.0.0 открывает порт всем: только при публичном доступе из раздела 6,
# где сайт закрыт паролем.
# WEB_BIND=127.0.0.1

# ============================================================================
# 6. ПУБЛИЧНЫЙ ДОСТУП ИЗ ИНТЕРНЕТА (docker-compose.public.yml): HTTPS
# ============================================================================
# Нужен только на сервере. Пошаговая инструкция: docs/DEPLOY.md, раздел 8.

# --- COMPOSE_FILE: какие compose-файлы читает `docker compose` ---------------
# Это стандартная переменная самого Docker Compose. Она заменяет флаги -f:
#   COMPOSE_FILE=docker-compose.yml:docker-compose.public.yml
# равно `docker compose -f docker-compose.yml -f docker-compose.public.yml ...`.
# Файлы перечисляются через двоеточие (на Windows через «;»), каждый следующий дополняет и переопределяет
# предыдущий: docker-compose.public.yml открывает порты 80/443, подключает Caddyfile.public и пароль.
# Без этой строки обычное `docker compose up -d` запустит только базовый файл, то есть режим «только localhost»:
# сайт снаружи пропадёт, и при обновлении (`git pull && docker compose up -d --build`) легко не заметить, что
# публичный режим выключился. Если строка не задана, Docker Compose читает только docker-compose.yml.
# Файл docker-compose.public.yml сам по себе пароль на сайт не ставит: вход в приложение работает всегда.
# COMPOSE_FILE=docker-compose.yml:docker-compose.public.yml

# Адрес сайта. Домен (например, expenses.example.com) или бесплатный адрес из IP сервера с дефисами
# (для IP 1.2.3.4: 1-2-3-4.nip.io). Caddy сам получит сертификат Let's Encrypt; для этого должны быть
# открыты порты 80 и 443, а имя должно указывать на сервер (проверка: dig +short ваш-адрес).
# SITE_ADDRESS=expenses.example.com
# Отдельный адрес для pgAdmin (для домена нужна своя A-запись; для nip.io: pgadmin.1-2-3-4.nip.io)
# PGADMIN_ADDRESS=pgadmin.example.com

# Вход на сайт защищает само приложение (логины и пароли выше), отдельного пароля Caddy на сайте нет.
# Пароль Caddy (Basic Auth) нужен только для pgAdmin: логин и хеш пароля.
# PGADMIN_BASIC_AUTH_USER=admin
# Хеш создаётся командой (пароль вводится в запросе и не остаётся в истории; нужен терминал):
#   docker run --rm -it expenses-tracker-web caddy hash-password
# Значение ОБЯЗАТЕЛЬНО в одинарных кавычках: в хеше есть символы $
# PGADMIN_BASIC_AUTH_HASH='$2a$14$...'
