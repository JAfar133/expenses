# SITE_ADDRESS defaults to ":80" (plain HTTP, for local runs).
# For HTTPS on a server, set a domain, e.g. expenses.example.com: Caddy obtains the certificate itself.
{$SITE_ADDRESS::80} {
	encode zstd gzip

	# The live notification stream (Server-Sent Events) must reach the browser at once, not in buffered pieces
	handle /api/notifications/stream {
		reverse_proxy backend:3000 {
			flush_interval -1
		}
	}

	# API: requests go to the backend, which is not published on a separate port
	handle /api/* {
		reverse_proxy backend:3000
	}

	# Frontend: static files; unknown paths fall back to index.html
	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}

	# API responses (including login cookies) must not end up in a shared cache
	@api path /api/*
	header @api Cache-Control "no-store"

	@assets path /assets/*
	header @assets Cache-Control "public, max-age=31536000, immutable"

	# The page itself (index.html) is revalidated on every open, so an installed app picks up a new version at once
	# (the hashed files in /assets stay cached for a year)
	@pages {
		not path /assets/* /api/*
	}
	header @pages Cache-Control "no-cache"

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy same-origin
		X-Frame-Options DENY
		-Server
	}
}
