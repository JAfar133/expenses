# syntax=docker/dockerfile:1

# --- Сборка TypeScript. Образ на glibc: нативный компилятор TypeScript 7 не поставляется для musl.
FROM node:22-bookworm-slim AS build
WORKDIR /app
COPY backend/package.json backend/package-lock.json ./
RUN npm ci
COPY backend/tsconfig.json backend/tsconfig.build.json ./
COPY backend/src ./src
RUN npm run build

# --- Рабочий образ: только production-зависимости, скомпилированный код и rclone
FROM node:22-alpine AS runtime
RUN apk add --no-cache rclone tini
ENV NODE_ENV=production
WORKDIR /app

COPY backend/package.json backend/package-lock.json ./
RUN npm ci --omit=dev && npm cache clean --force

COPY --from=build /app/dist ./dist
COPY infra/docker-entrypoint.sh /usr/local/bin/docker-entrypoint.sh

# /data: конфигурация rclone и резервные копии (том)
RUN mkdir -p /data && chown node:node /data
VOLUME /data

USER node
EXPOSE 3000

HEALTHCHECK --interval=15s --timeout=5s --start-period=30s --retries=5 \
  CMD wget -qO- http://127.0.0.1:3000/api/health >/dev/null || exit 1

ENTRYPOINT ["/sbin/tini", "--", "docker-entrypoint.sh"]
