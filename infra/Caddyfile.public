# Публичный доступ к приложению: HTTPS и вход по логину и паролю.
# Временная защита, пока в самом приложении нет авторизации (см. docker-compose.public.yml).
#
# SITE_ADDRESS — домен, на который указывает ваш сервер. Домена нет — возьмите бесплатный адрес
# вида 85-209-51-95.nip.io (IP с дефисами): Caddy сам получит для него сертификат.
{$SITE_ADDRESS} {
	encode zstd gzip

	# Манифест и иконки не секретны, но браузеры запрашивают их без пароля
	# (без этого на iPhone не установится значок приложения)
	@protected not path /manifest.webmanifest /icons/*
	basic_auth @protected {
		{$BASIC_AUTH_USER} {$BASIC_AUTH_HASH}
	}

	handle /api/* {
		reverse_proxy backend:3000
	}

	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}

	@assets path /assets/*
	header @assets Cache-Control "public, max-age=31536000, immutable"

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy same-origin
		X-Frame-Options DENY
		Strict-Transport-Security "max-age=604800"
		-Server
	}
}

# pgAdmin (веб-интерфейс к базе) на отдельном адресе: тот же логин и пароль Caddy, затем собственный вход pgAdmin.
# Порт pgAdmin наружу не публикуется: до него можно добраться только через этот сайт, по HTTPS и под паролем.
# PGADMIN_ADDRESS — отдельное имя, например pgadmin.85-209-51-95.nip.io (для домена: pgadmin.example.com).
{$PGADMIN_ADDRESS} {
	encode zstd gzip

	basic_auth {
		{$BASIC_AUTH_USER} {$BASIC_AUTH_HASH}
	}

	reverse_proxy pgadmin:80

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy same-origin
		Strict-Transport-Security "max-age=604800"
		-Server
	}
}
