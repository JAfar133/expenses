# Public access to the app: HTTPS on your address.
#
# Login is enforced by the app itself (user logins and passwords, sessions), so Caddy has no separate
# password on the site: double authentication would only get in the way. The Caddy password (Basic Auth) is kept
# for pgAdmin, which is not part of the app.
#
# SITE_ADDRESS is the domain your server points to (e.g. expenses.example.com). No domain? Use a free
# address like 1-2-3-4.nip.io (IP with dashes): Caddy obtains a certificate for it itself.
{$SITE_ADDRESS} {
	encode zstd gzip

	handle /api/* {
		reverse_proxy backend:3000
	}

	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}

	@assets path /assets/*
	header @assets Cache-Control "public, max-age=31536000, immutable"

	# Service pages must not be cached, and API responses (including login cookies) must not end up in a shared cache
	@api path /api/*
	header @api Cache-Control "no-store"

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy same-origin
		X-Frame-Options DENY
		Strict-Transport-Security "max-age=604800"
		-Server
	}
}

# pgAdmin (web UI for the database) on a separate address: Caddy password (Basic Auth), then pgAdmin's own login.
# The pgAdmin port is not published; it can only be reached through this site, over HTTPS.
# PGADMIN_ADDRESS is a separate name, e.g. pgadmin.example.com (for nip.io: pgadmin.1-2-3-4.nip.io).
{$PGADMIN_ADDRESS} {
	encode zstd gzip

	basic_auth {
		{$PGADMIN_BASIC_AUTH_USER} {$PGADMIN_BASIC_AUTH_HASH}
	}

	reverse_proxy pgadmin:80

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy same-origin
		Strict-Transport-Security "max-age=604800"
		-Server
	}
}
