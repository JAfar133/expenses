# Публичный доступ к приложению: HTTPS на вашем адресе.
#
# Сайт защищает вход в самом приложении (логин и пароль пользователей, сессии), поэтому отдельного пароля
# Caddy на нём нет: двойная авторизация только мешала бы. Пароль Caddy (Basic Auth) оставлен у pgAdmin:
# он не является частью приложения.
#
# SITE_ADDRESS — домен, на который указывает ваш сервер (например, expenses.example.com). Домена нет — возьмите
# бесплатный адрес вида 1-2-3-4.nip.io (IP с дефисами): Caddy сам получит для него сертификат.
{$SITE_ADDRESS} {
	encode zstd gzip

	handle /api/* {
		reverse_proxy backend:3000
	}

	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}

	@assets path /assets/*
	header @assets Cache-Control "public, max-age=31536000, immutable"

	# Сервис-страницы не должны кешироваться, а ответы API (включая куки входа) не должны попадать в общий кеш
	@api path /api/*
	header @api Cache-Control "no-store"

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy same-origin
		X-Frame-Options DENY
		Strict-Transport-Security "max-age=604800"
		-Server
	}
}

# pgAdmin (веб-интерфейс к базе) на отдельном адресе: пароль Caddy (Basic Auth), затем собственный вход pgAdmin.
# Порт pgAdmin наружу не публикуется: до него можно добраться только через этот сайт, по HTTPS.
# PGADMIN_ADDRESS — отдельное имя, например pgadmin.example.com (для nip.io: pgadmin.1-2-3-4.nip.io).
{$PGADMIN_ADDRESS} {
	encode zstd gzip

	basic_auth {
		{$PGADMIN_BASIC_AUTH_USER} {$PGADMIN_BASIC_AUTH_HASH}
	}

	reverse_proxy pgadmin:80

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy same-origin
		Strict-Transport-Security "max-age=604800"
		-Server
	}
}
