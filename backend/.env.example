# Application
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
APP_TIMEZONE=Asia/Yerevan
DEFAULT_CURRENCY=AMD
# Expense currencies (the first is the base). Foreign ones are converted to drams at the Central Bank
# of Armenia rate; Excel receives drams
# CURRENCIES=AMD,RUB,USD,EUR
# EXCHANGE_RATES_URL=https://cb.am/latest.json.php
# EXCHANGE_RATES_REFRESH_HOURS=6

# Excel
EXCEL_SHEET_NAME=Лист1
EXCEL_TABLE_NAME=Операции

# OneDrive. ONEDRIVE_FILE_PATH is optional: empty or unset disables Excel integration,
# expenses are stored only in the database. If the file is set but unavailable, the app does not
# crash: expenses wait in the queue.
ONEDRIVE_REMOTE=onedrive
ONEDRIVE_FILE_PATH=Документы/Расходы-dev.xlsx
# RCLONE_CONFIG=/run/secrets/rclone.conf
# daemon (default): a persistent rclone process, a write takes about 5 seconds
# cli: a separate rclone run for every command, a write takes about 20-30 seconds
# RCLONE_MODE=daemon
# RCLONE_TIMEOUT_MS=120000

# PostgreSQL (locally started via `docker compose up -d postgres`)
DATABASE_URL=postgres://expenses:expenses@127.0.0.1:5433/expenses

# Excel backups before each write
BACKUP_DIR=./backups
BACKUP_RETENTION_DAYS=30

# PostgreSQL <-> Excel synchronization
SYNC_INTERVAL_MINUTES=5
# While records cannot be appended to Excel (the file is open), retry more often
SYNC_RETRY_SECONDS=60
# How long to wait for the Excel write before responding to an expense creation
SYNC_INLINE_WAIT_SECONDS=15
# Safeguard: if more than this share of records disappears from Excel in one cycle,
# they are not marked as deleted
SYNC_MAX_DELETE_PERCENT=25

# Reference lists (comma-separated)
CARDS=Миша,Настя
CATEGORIES=кафе,одежда,продукты,жилье,маркетплейс,другое

# App login. Users: login:default card. Passwords: AUTH_PASSWORD_<LOGIN>, at least 8 characters.
# If a password is empty, scripts/start-all.sh generates a random one for development and writes it here.
AUTH_USERS=misha:Миша,nastya:Настя
# Who can edit and delete records (comma-separated logins); everyone else is read-only
# EDITOR_USERS=misha
AUTH_PASSWORD_MISHA=
AUTH_PASSWORD_NASTYA=
# Lifetimes: access token 24 hours, refresh token 7 days, session limit 30 days
# ACCESS_TOKEN_TTL_HOURS=24
# REFRESH_TOKEN_TTL_DAYS=7
# SESSION_MAX_DAYS=30
# Minimum password length (not less than 8)
# AUTH_MIN_PASSWORD_LENGTH=8
# Enable behind a reverse proxy (Caddy): the real IP and HTTPS are taken from X-Forwarded-*.
# Not needed in development.
# TRUST_PROXY=false
# Additional site origins allowed to make requests (comma-separated); usually not needed
# ALLOWED_ORIGINS=
