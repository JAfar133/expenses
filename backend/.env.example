# Backend settings for running outside Docker (npm run dev). Copy to backend/.env.
# Lines starting with "#" are optional, the value shown is the default.

NODE_ENV=development
HOST=127.0.0.1
PORT=3000
DATABASE_URL=postgres://expenses:expenses@127.0.0.1:5433/expenses
# true behind a reverse proxy (Caddy)
# TRUST_PROXY=false
# ALLOWED_ORIGINS=

APP_TIMEZONE=Asia/Yerevan
DEFAULT_CURRENCY=AMD
# CURRENCIES=AMD,RUB,USD,EUR
# EXCHANGE_RATES_URL=https://cb.am/latest.json.php
# EXCHANGE_RATES_REFRESH_HOURS=6

# --- First users ----------------------------------------------------------
# Everything else (people, cards, categories) is managed in the app, on the "Группа" page.
# The variables below only prepare the first group on the first start.

# Passwords, at least 8 characters. If empty, scripts/start-all.sh generates them here.
AUTH_USERS=misha:Миша,nastya:Настя
AUTH_PASSWORD_MISHA=
AUTH_PASSWORD_NASTYA=
# Application administrators (they create groups)
# ADMIN_USERS=misha
# Owners of the first group
# EDITOR_USERS=misha
# DEFAULT_GROUP_NAME=Семья
# CARDS=Миша,Настя
# CATEGORIES=кафе,одежда,продукты,жилье,маркетплейс,другое
# ACCESS_TOKEN_TTL_HOURS=24
# REFRESH_TOKEN_TTL_DAYS=7
# SESSION_MAX_DAYS=30
# AUTH_MIN_PASSWORD_LENGTH=8

BACKUP_DIR=./backups
# Receipt photos (default ./receipts)
# RECEIPTS_DIR=./receipts
BACKUP_RETENTION_DAYS=30
# Folder with the status files of scripts/backup-db.sh (shown to the administrator); empty: not shown
# DB_BACKUP_STATUS_DIR=
# DB_BACKUP_MAX_AGE_HOURS=26

# --- Excel sync (DEPRECATED, off by default) ------------------------------
# Empty ONEDRIVE_FILE_PATH: expenses are stored in the database only.
ONEDRIVE_REMOTE=onedrive
ONEDRIVE_FILE_PATH=Документы/Расходы-dev.xlsx
EXCEL_SHEET_NAME=Лист1
EXCEL_TABLE_NAME=Операции
# RCLONE_CONFIG=/run/secrets/rclone.conf
# daemon: ~5 s per write; cli: ~20-30 s
# RCLONE_MODE=daemon
# RCLONE_TIMEOUT_MS=120000
# SYNC_INTERVAL_MINUTES=5
# SYNC_RETRY_SECONDS=60
# SYNC_INLINE_WAIT_SECONDS=15
# SYNC_MAX_DELETE_PERCENT=25
