# Application
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
APP_TIMEZONE=Asia/Yerevan
DEFAULT_CURRENCY=AMD
# Валюты расходов (первой базовая). Иностранные пересчитываются в драммы по курсу ЦБ Армении; в Excel идут драммы
# CURRENCIES=AMD,RUB,USD,EUR
# EXCHANGE_RATES_URL=https://cb.am/latest.json.php
# EXCHANGE_RATES_REFRESH_HOURS=6

# Excel
EXCEL_SHEET_NAME=Лист1
EXCEL_TABLE_NAME=Операции

# OneDrive. ONEDRIVE_FILE_PATH необязателен: пустой или не заданный отключает работу с Excel,
# расходы хранятся только в базе. Если файл задан, но недоступен, приложение не падает: расходы ждут в очереди.
ONEDRIVE_REMOTE=onedrive
ONEDRIVE_FILE_PATH=Документы/Расходы-dev.xlsx
# RCLONE_CONFIG=/run/secrets/rclone.conf
# daemon (по умолчанию) — постоянный процесс rclone, запись около 5 секунд
# cli — отдельный запуск rclone на каждую команду, запись около 20-30 секунд
# RCLONE_MODE=daemon
# RCLONE_TIMEOUT_MS=120000

# PostgreSQL (локально поднимается через `docker compose up -d postgres`)
DATABASE_URL=postgres://expenses:expenses@127.0.0.1:5433/expenses

# Резервные копии Excel перед каждой записью
BACKUP_DIR=./backups
BACKUP_RETENTION_DAYS=30

# Синхронизация PostgreSQL <-> Excel
SYNC_INTERVAL_MINUTES=5
# Пока записи не удаётся дописать в Excel (файл открыт), пробуем чаще
SYNC_RETRY_SECONDS=60
# Сколько ждать записи в Excel перед ответом на создание расхода
SYNC_INLINE_WAIT_SECONDS=15
# Защита: если за один цикл пропало больше этой доли записей из Excel, они не помечаются удалёнными
SYNC_MAX_DELETE_PERCENT=25

# Справочники (через запятую)
CARDS=Миша,Настя
CATEGORIES=кафе,одежда,продукты,жилье,маркетплейс,другое

# Вход в приложение. Пользователи: логин:карта по умолчанию. Пароли: AUTH_PASSWORD_<ЛОГИН>, не короче 8 символов.
# Если пароль пуст, scripts/start-all.sh создаст случайный для разработки и запишет сюда.
AUTH_USERS=misha:Миша,nastya:Настя
AUTH_PASSWORD_MISHA=
AUTH_PASSWORD_NASTYA=
# Сроки: access-токен 24 часа, refresh-токен 7 дней, предел сессии 30 дней
# ACCESS_TOKEN_TTL_HOURS=24
# REFRESH_TOKEN_TTL_DAYS=7
# SESSION_MAX_DAYS=30
# Минимальная длина пароля (не меньше 8)
# AUTH_MIN_PASSWORD_LENGTH=8
# За обратным прокси (Caddy) включите: реальный IP и HTTPS берутся из X-Forwarded-*. В разработке не нужно.
# TRUST_PROXY=false
# Дополнительные адреса сайта, с которых разрешены запросы (через запятую); обычно не нужно
# ALLOWED_ORIGINS=
